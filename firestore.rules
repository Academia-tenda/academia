rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner() {
      return signed() && exists(/databases/$(database)/documents/perfis/_adm)
        && get(/databases/$(database)/documents/perfis/_adm).data.dono == request.auth.uid;
    }
    function professional() {
      return signed() && (owner() || (exists(/databases/$(database)/documents/perfis/$(request.auth.uid))
        && get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.role == 'professor'));
    }
    function linksEnabled() {
      return exists(/databases/$(database)/documents/config/vinculos)
        && get(/databases/$(database)/documents/config/vinculos).data.ativo == true;
    }
    function linked(uid) {
      return exists(/databases/$(database)/documents/vinculos/$(uid))
        && get(/databases/$(database)/documents/vinculos/$(uid)).data.ativo == true
        && get(/databases/$(database)/documents/vinculos/$(uid)).data.professorUid == request.auth.uid
        && get(/databases/$(database)/documents/perfis/$(uid)).data.professorUid == request.auth.uid;
    }
    function canCoach(uid) {
      return owner() || (professional() && (!linksEnabled() || linked(uid)));
    }
    function free(uid) {
      return get(/databases/$(database)/documents/perfis/$(uid)).data.get('professorUid', '') == ''
        && (!exists(/databases/$(database)/documents/vinculos/$(uid))
          || get(/databases/$(database)/documents/vinculos/$(uid)).data.ativo == false);
    }
    function eligible(uid) {
      return professional() && linksEnabled() && uid != request.auth.uid
        && exists(/databases/$(database)/documents/perfis/$(uid))
        && get(/databases/$(database)/documents/perfis/$(uid)).data.role == 'aluno';
    }
    function assignedAfter(uid, active) {
      return existsAfter(/databases/$(database)/documents/vinculos/$(uid))
        && getAfter(/databases/$(database)/documents/vinculos/$(uid)).data.ativo == active
        && getAfter(/databases/$(database)/documents/vinculos/$(uid)).data.professorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/perfis/$(uid)).data.professorUid
          == (active ? request.auth.uid : '');
    }
    match /config/vinculos {
      allow get: if signed();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['ativo', 'ativadoPor', 'ativadoEm'])
        && request.resource.data.ativo == true
        && request.resource.data.ativadoPor == request.auth.uid;
    }
    match /perfis/_adm {
      // O responsável existente é preservado. Cadastro inicial é administrativo.
      allow get: if owner();
      allow update: if owner() && request.resource.data.dono == resource.data.dono;
    }
    match /perfis/{uid} {
      allow create: if signed() && request.auth.uid == uid && uid != '_adm'
        && request.resource.data.uid == uid && request.resource.data.role == 'aluno'
        && !request.resource.data.keys().hasAny(['professorUid']);
      allow get: if signed() && uid != '_adm' && (request.auth.uid == uid || owner()
        || (professional() && (resource.data.role == 'aluno' || canCoach(uid))));
      allow list: if professional() && (owner() || !linksEnabled()
        || resource.data.role == 'aluno' || resource.data.get('professorUid', '') == request.auth.uid);
      allow update: if signed() && request.auth.uid == uid && uid != '_adm'
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'email', 'role'])
        && (request.resource.data.role == resource.data.role
          || (resource.data.role in ['aluno', 'pendente'] && request.resource.data.role in ['aluno', 'pendente']))
        ;
      allow update: if owner() && uid != '_adm'
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'email', 'role'])
        && request.resource.data.role in ['aluno', 'pendente', 'professor', 'dono']
        && (request.resource.data.role != 'dono' || uid == request.auth.uid);
    }
    match /perfis/{uid} {
      allow update: if eligible(uid) && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['professorUid'])
        && ((free(uid) && assignedAfter(uid, true))
          || (resource.data.get('professorUid', '') == request.auth.uid
            && exists(/databases/$(database)/documents/vinculos/$(uid))
            && get(/databases/$(database)/documents/vinculos/$(uid)).data.ativo == true
            && get(/databases/$(database)/documents/vinculos/$(uid)).data.professorUid == request.auth.uid
            && assignedAfter(uid, false)));
    }
    match /vinculos/{uid} {
      // Metadados do vínculo podem ser consultados para conferir disponibilidade.
      allow get: if signed() && (request.auth.uid == uid || professional());
      allow create, update: if eligible(uid) && free(uid) && assignedAfter(uid, true)
        && request.resource.data.keys().hasOnly(['alunoUid', 'professorUid', 'professorNome', 'ativo', 'atribuidoEm'])
        && request.resource.data.alunoUid == uid
        && request.resource.data.professorUid == request.auth.uid
        && request.resource.data.professorNome is string
        && request.resource.data.professorNome.size() <= 160
        && request.resource.data.atribuidoEm is number
        && request.resource.data.ativo == true;
      // Aceita vínculos antigos, mas só o instrutor atual pode liberá-los.
      allow update: if eligible(uid) && resource.data.ativo == true
        && resource.data.professorUid == request.auth.uid
        && get(/databases/$(database)/documents/perfis/$(uid)).data.professorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo'])
        && request.resource.data.ativo == false && assignedAfter(uid, false);
    }
    match /usuarios/{uid} {
      allow get: if signed() && (request.auth.uid == uid || canCoach(uid));
      allow list: if owner();
      allow create: if signed() && (request.auth.uid == uid || canCoach(uid));
      allow update: if signed() && request.auth.uid == uid;
      allow update: if canCoach(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['treinos']);
      allow delete: if signed() && request.auth.uid == uid;
    }
    match /planosProfessor/{uid} {
      allow get: if signed() && (request.auth.uid == uid || canCoach(uid));
      allow list: if owner();
      allow create, update: if canCoach(uid)
        && request.resource.data.keys().hasOnly(['versao', 'ficha', 'treinos', 'nomes', 'alimentar', 'uid', 'professorUid', 'alunoNome', 'atualizadoEm', 'revisao'])
        && request.resource.data.uid == uid
        && request.resource.data.professorUid == request.auth.uid
        && request.resource.data.ficha is map
        && request.resource.data.treinos is map
        && request.resource.data.nomes is map
        && request.resource.data.alimentar is map
        && request.resource.data.alimentar.refeicoes is list
        && request.resource.data.revisao is string;
      allow delete: if owner();
    }
  }
}
